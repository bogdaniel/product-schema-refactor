{
  "name": "bogdaniel/product-schema-refactor",
  "description": "A PSR-12, SOLID and DRY product JSON-LD schema refactor example.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "laravel/pint": "^1.18",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "ProductSchema\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ProductSchema\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "format": "pint",
    "check": [
      "@format -- --test",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
